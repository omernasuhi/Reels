# Uygulama
APP_URL=http://localhost:3000
# Yönetici sayfasını görecek e-postalar (virgülle). profiles.is_admin = true da aynı işi görür.
ADMIN_EMAILS=

# Supabase (yalnızca sunucuda kullanılır; tarayıcıya anahtar gönderilmez)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5

# Replicate
REPLICATE_API_TOKEN=
REPLICATE_IMAGE_MODEL=bytedance/seedream-5-pro
# Webhook imza anahtarı (whsec_...). APP_URL https değilse webhook kullanılmaz, sonuçlar yoklanır.
REPLICATE_WEBHOOK_SECRET=
IMAGE_CONCURRENCY=8

# ElevenLabs
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_v3

# Cloudflare R2 (S3 uyumlu). Boş bırakılırsa dosyalar LOCAL_STORAGE_DIR altına yazılır.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
LOCAL_STORAGE_DIR=.data/storage
# Yerel dosya adreslerini imzalamak için (boşsa SUPABASE_SERVICE_ROLE_KEY kullanılır)
FILE_SIGNING_SECRET=

# Inngest. Yerelde: INNGEST_DEV=1 ve `npx inngest-cli@latest dev -u http://localhost:3000/api/inngest`
INNGEST_DEV=
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# Remotion. Lambda değişkenleri boşsa render yerelde @remotion/renderer ile yapılır.
REMOTION_AWS_ACCESS_KEY_ID=
REMOTION_AWS_SECRET_ACCESS_KEY=
REMOTION_AWS_REGION=
REMOTION_FUNCTION_NAME=
REMOTION_SERVE_URL=
# Yerel render için isteğe bağlı: hazır bir chrome-headless-shell yolu
REMOTION_BROWSER_EXECUTABLE=

# ffmpeg (sessizlik kırpma). PATH'te değilse tam yolunu yaz.
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# Stripe (bu sürümde kullanılmıyor; ödeme sağlayıcısı arayüzü src/lib/payments.ts)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
